{
  "name": "au-com-agileware-ewayrecurring-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright tests for the eWay Recurring CiviCRM extension. See README.md.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "seed": "sh -c '$CIVI_EXEC_PREFIX ${CIVI_CV:-cv} scr tests/playwright/fixtures/seed-data.php'"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  }
}
